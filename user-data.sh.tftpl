#!/bin/bash
# No `set -x` — the fetched private key must never land in the boot log.
set -euo pipefail

# t4g.nano has 512 MB, and on a current AL2023 AMI `dnf` alone exceeds that while
# parsing repo metadata — the install gets OOM-killed and the box comes up bare. The
# EBS volume is already paid for, so a swapfile fixes it at no cost. Must run BEFORE
# the first dnf. (Symptom without it: a tunnel that connects but passes no traffic.)
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# install_weak_deps=False keeps the transaction small, which matters on 512 MB.
dnf install -y --setopt=install_weak_deps=False wireguard-tools iptables-nft squid

# We manage this box via SSM, so SSH is unnecessary attack surface.
systemctl disable --now sshd 2>/dev/null || true

# Automatic security updates.
dnf install -y dnf-automatic || true
sed -i 's/^apply_updates = no/apply_updates = yes/'      /etc/dnf/automatic.conf 2>/dev/null || true
sed -i 's/^upgrade_type = default/upgrade_type = security/' /etc/dnf/automatic.conf 2>/dev/null || true
systemctl enable --now dnf-automatic.timer 2>/dev/null || true

# IP forwarding.
echo 'net.ipv4.ip_forward = 1' > /etc/sysctl.d/99-wireguard.conf
sysctl -p /etc/sysctl.d/99-wireguard.conf

# Primary interface, for NAT masquerade.
IFACE=$(ip route show default | awk '{print $5; exit}')

# Fetch a Secrets Manager secret's value, or generate + store it if empty. Retries
# while the instance role finishes propagating on first boot. Get-or-create keeps
# the values stable across rebuilds, so the client config never needs re-importing.
get_or_create() {
  local arn="$1" gen="$2" val new i
  for i in $(seq 1 30); do
    val=$(aws secretsmanager get-secret-value --region ${region} --secret-id "$arn" --query SecretString --output text 2>/dev/null || true)
    if [ -n "$val" ] && [ "$val" != "None" ]; then printf '%s' "$val"; return 0; fi
    new=$($gen)
    ( umask 077; printf '%s' "$new" > /root/.wgtmp )
    if aws secretsmanager put-secret-value --region ${region} --secret-id "$arn" --secret-string "file:///root/.wgtmp" >/dev/null 2>&1; then
      rm -f /root/.wgtmp; printf '%s' "$new"; return 0
    fi
    rm -f /root/.wgtmp; sleep 5
  done
  return 1
}

SRV_PRIV=$(get_or_create "${priv_secret_id}" "wg genkey")  || { echo "FATAL: could not obtain server key" >&2; exit 1; }
PSK=$(get_or_create "${psk_secret_id}" "wg genpsk")        || { echo "FATAL: could not obtain preshared key" >&2; exit 1; }

umask 077

# Every peer shares this PSK, so cache it locally: the sync script below runs on a
# timer and shouldn't hit Secrets Manager each time. Root-only.
printf '%s' "$PSK" > /etc/wireguard/psk
chmod 600 /etc/wireguard/psk

# [Interface] only — the [Peer] blocks are written by wg-sync-peers from the SSM
# parameter Terraform publishes. That indirection is what lets you add or remove a
# profile without rebuilding this instance.
cat > /etc/wireguard/wg0.conf <<WG
[Interface]
Address = ${wg_net}.1/24
ListenPort = ${wg_port}
PrivateKey = $SRV_PRIV
PostUp   = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o $IFACE -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o $IFACE -j MASQUERADE
WG

cat > /usr/local/sbin/wg-sync-peers <<'SYNC'
#!/bin/bash
# Rebuild wg0's peer list from SSM and apply it. Uses `wg syncconf`, which diffs
# against the running interface rather than restarting it — so adding or removing
# somebody's profile never drops the tunnels that are already connected.
set -euo pipefail

CONF=/etc/wireguard/wg0.conf
PSK_FILE=/etc/wireguard/psk

peers=$(aws ssm get-parameter --region ${region} --name "${peers_param}" \
          --query Parameter.Value --output text 2>/dev/null || true)
if [ -z "$peers" ] || [ "$peers" = "None" ]; then
  echo "wg-sync-peers: peer list unavailable; keeping the current config" >&2
  exit 0
fi

psk=$(cat "$PSK_FILE")
tmp=$(mktemp /etc/wireguard/.sync.XXXXXX)   # same fs as CONF, so the mv is atomic
chmod 600 "$tmp"

# Keep the [Interface] section, discard every existing [Peer] block. NF drops blank
# lines: without it the blank separating [Interface] from the first [Peer] is kept and
# re-added on every run, so the file would grow a line each time the timer fires.
awk '/^\[Peer\]/{exit} NF' "$CONF" > "$tmp"

# One "name pubkey ip_suffix" line per profile.
while read -r name pub suffix; do
  [ -n "$pub" ] || continue
  [ -n "$suffix" ] || continue
  printf '\n[Peer]\n# %s\nPublicKey = %s\nPresharedKey = %s\nAllowedIPs = %s.%s/32\n' \
    "$name" "$pub" "$psk" "${wg_net}" "$suffix" >> "$tmp"
done <<< "$peers"

# Nothing to do on the vast majority of timer ticks — skip the write and the reload.
if cmp -s "$tmp" "$CONF"; then
  rm -f "$tmp"
  exit 0
fi

mv "$tmp" "$CONF"
chmod 600 "$CONF"

# Apply live when the interface is up; otherwise the file is read on next start.
if ip link show wg0 >/dev/null 2>&1; then
  wg syncconf wg0 <(wg-quick strip wg0)
fi
echo "wg-sync-peers: applied $(grep -c '^\[Peer\]' "$CONF") peer(s)"
SYNC
chmod 700 /usr/local/sbin/wg-sync-peers

cat > /etc/systemd/system/wg-sync-peers.service <<'UNIT'
[Unit]
Description=Sync WireGuard peers from SSM
After=wg-quick@wg0.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/wg-sync-peers
UNIT

# OnBootSec covers the normal start-of-session boot; OnUnitActiveSec means a profile
# added while the box is already running shows up within a couple of minutes.
cat > /etc/systemd/system/wg-sync-peers.timer <<'UNIT'
[Unit]
Description=Periodically sync WireGuard peers from SSM

[Timer]
OnBootSec=30s
OnUnitActiveSec=2min
AccuracySec=15s

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now wg-quick@wg0
systemctl enable --now wg-sync-peers.timer
# Pull the peers in now so the box is usable without waiting for the first timer tick.
/usr/local/sbin/wg-sync-peers || echo "WARN: initial peer sync failed; the timer will retry" >&2

# Forward proxy for domain-based split tunneling. Reachable ONLY from the tunnel
# subnet (the security group never exposes 3128), so browser traffic for the
# selected domains is proxied out of the VPN region with server-side DNS resolution.
cat > /etc/squid/squid.conf <<'SQUID'
acl SSL_ports port 443
acl Safe_ports port 80 443
acl CONNECT method CONNECT
acl wgclients src ${wg_net}.0/24

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow wgclients
http_access deny all

http_port 3128
cache deny all
access_log none
SQUID
systemctl enable --now squid

SRV_PUB=$(printf '%s' "$SRV_PRIV" | wg pubkey)
unset SRV_PRIV PSK
aws ssm put-parameter --region ${region} --name "${param_name}" --type String --overwrite --value "$SRV_PUB" >/dev/null 2>&1 || true

# Readiness beacon, published LAST. It carries THIS instance's id, not just "done":
# the public key parameter survives an instance replacement, so it can't distinguish a
# freshly-built box from a dead one that inherited a valid key. up.sh compares this to
# the instance it just started and refuses to hand out configs until they match.
TOKEN=$(curl -sf -X PUT "http://169.254.169.254/latest/api/token" \
          -H "X-aws-ec2-metadata-token-ttl-seconds: 300" || true)
IID=$(curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/instance-id || true)
if [ -n "$IID" ]; then
  aws ssm put-parameter --region ${region} --name "${ready_param}" --type String --overwrite --value "$IID" >/dev/null 2>&1 || true
fi
